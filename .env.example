# Public Supabase project values (same project as the Sonx mobile app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" after the Apple Services ID and client secret are configured
# in the Supabase Apple provider (see scripts/apple-client-secret.mjs).
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=

# Paddle web checkout (Paddle > Developer tools > Authentication > Client-side tokens).
# Use "sandbox" with a test_ token while testing; leave empty for production.
# Without a token and prices the web keeps sending buyers to the app.
NEXT_PUBLIC_PADDLE_ENV=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle price IDs (pri_...). Pro bills monthly or yearly with the MONTHLY quota;
# Studio is web-only with the STUDIO quota. Map every plan price on provider-proxy
# in PADDLE_PLAN_PRODUCTS, e.g. {"pri_pro_yearly":"MONTHLY","pri_studio_monthly":"STUDIO"}.
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_STUDIO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_STUDIO_YEARLY=
# One-time credit packs, sold only to subscribers. Map them in
# PADDLE_CREDIT_PRODUCTS on provider-proxy, e.g. {"pri_...":100}.
NEXT_PUBLIC_PADDLE_PRICE_CREDITS_100=
NEXT_PUBLIC_PADDLE_PRICE_CREDITS_250=
NEXT_PUBLIC_PADDLE_PRICE_CREDITS_600=
NEXT_PUBLIC_PADDLE_PRICE_CREDITS_1500=
