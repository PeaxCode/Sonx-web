# Public Supabase project values (same project as the Sonx mobile app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" after the Apple Services ID and client secret are configured
# in the Supabase Apple provider (see scripts/apple-client-secret.mjs).
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=

# Paddle web checkout (Paddle > Developer tools > Authentication > Client-side tokens).
# Use "sandbox" with a test_ token while testing; leave empty for production.
# Without a token and prices the web keeps sending buyers to the app.
NEXT_PUBLIC_PADDLE_ENV=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle price IDs (pri_...). The same IDs go into PADDLE_PLAN_PRODUCTS on the
# provider-proxy Edge Function so the server knows each plan's quota.
NEXT_PUBLIC_PADDLE_PRICE_WEEKLY=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_YEARLY=
# One-time credit packs (40 / 95 / 210 / 445 credits). The same IDs go into
# PADDLE_CREDIT_PRODUCTS on provider-proxy, e.g. {"pri_...":40}.
NEXT_PUBLIC_PADDLE_PRICE_CREDITS_MINI=
NEXT_PUBLIC_PADDLE_PRICE_CREDITS_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_CREDITS_PRO=
NEXT_PUBLIC_PADDLE_PRICE_CREDITS_STUDIO=
